# Variables de entorno para las Edge Functions en desarrollo local
# ¡Este archivo NUNCA debe subirse al repositorio!
# Agrégalo a .gitignore si no está ya incluido.

# Clave secreta de Cloudflare Turnstile
# En producción: supabase secrets set TURNSTILE_SECRET_KEY=<valor>
# Para pruebas locales, usa la clave de test de Cloudflare:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Origen permitido para CORS (en prod: tu dominio real)
CORS_ORIGIN=http://localhost:5173

# Nota: SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY son inyectadas
# automáticamente por `supabase functions serve` y en producción.
# Solo agrégalas aquí si tienes problemas en local.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<service role key de supabase start>

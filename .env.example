# =============================================================
# FRONTEND (expuestas al navegador — deben empezar con VITE_)
# =============================================================

# URL del proyecto Supabase (dashboard → Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anon/public (dashboard → Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de sitio de Cloudflare Turnstile (panel Turnstile → site key)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAA...

# =============================================================
# EDGE FUNCTIONS (secretos del servidor — NUNCA en el frontend)
# Estos se configuran con: supabase secrets set NOMBRE=valor
# =============================================================

# Clave secreta de Cloudflare Turnstile (panel Turnstile → secret key)
TURNSTILE_SECRET_KEY=0x4AAAAAAAA...

# Nota: SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY son inyectadas
# automáticamente por el runtime de Supabase en producción.
# Para desarrollo local, se definen en supabase/functions/.env
# (archivo que TAMPOCO debe subirse al repositorio).

# =============================================================
# SOLO PARA DESARROLLO LOCAL
# =============================================================

# URL local de Supabase (generada por `supabase start`)
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<anon key que imprime supabase start>
